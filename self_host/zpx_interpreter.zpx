# zpx_interpreter.zpx - Full Zpx interpreter written in Zpx
# This is a self-hosting Zpx interpreter: parses and executes Zpx code
# Usage: zpx run zpx_interpreter.zpx <script.zpx>

# ---- Main Execution ----

fn execute(source, filename):
  let tokens = tokenize(source, filename)
  let ast = parse(tokens)
  let env = create_global_env()
  ret eval_program(ast, env)

# ---- Integration with Zpx CLI ----

fn run_interpreter(script_file):
  let source = read_file(script_file)
  let result = execute(source, script_file)
  if result != none:
    print(result)

# ---- REPL ----

fn run_repl():
  print("Zpx REPL (self-hosted)")
  print("Type 'exit' to quit")

  let env = create_global_env()

  while true:
    let line = input(">>> ")
    if line == "exit":
      break
    if line == "":
      continue
    let result = execute(line, "<repl>")
    if result != none:
      print("= " + str(result))

# ---- Tokenizer ----

fn tokenize(source, filename):
  let tokens = []
  let i = 0
  let line = 1
  let col = 1

  while i < len(source):
    let ch = source[i]
    let ch2 = ""
    if i + 1 < len(source):
      ch2 = source[i + 1]

    # Skip whitespace (but track newlines)
    if ch == "\n":
      line = line + 1
      col = 1
      i = i + 1
      continue
    if ch == " " or ch == "\t" or ch == "\r":
      col = col + 1
      i = i + 1
      continue

    # Skip comments
    if ch == "/" and ch2 == "/":
      while i < len(source) and source[i] != "\n":
        i = i + 1
      continue

    # Numbers
    if (ch >= "0" and ch <= "9") or (ch == "." and ch2 >= "0" and ch2 <= "9"):
      let num_str = ""
      let is_float = false
      while i < len(source) and ((source[i] >= "0" and source[i] <= "9") or source[i] == "."):
        if source[i] == ".":
          is_float = true
        num_str = num_str + source[i]
        i = i + 1
      if is_float:
        tokens.append({"type": "FLOAT", "value": float(num_str), "line": line, "col": col})
      el:
        tokens.append({"type": "NUMBER", "value": int(num_str), "line": line, "col": col})
      col = col + string_len(num_str)
      continue

    # Strings
    if ch == '"' or ch == "'":
      let quote = ch
      let str_val = ""
      i = i + 1
      while i < len(source) and source[i] != quote:
        if source[i] == "\\" and i + 1 < len(source):
          i = i + 1
          if source[i] == "n":
            str_val = str_val + "\n"
          el:
            if source[i] == "t":
              str_val = str_val + "\t"
            el:
              if source[i] == "\\":
                str_val = str_val + "\\"
              el:
                if source[i] == quote:
                  str_val = str_val + quote
                el:
                  str_val = str_val + source[i]
        el:
          str_val = str_val + source[i]
        i = i + 1
      i = i + 1  # skip closing quote
      tokens.append({"type": "STRING", "value": str_val, "line": line, "col": col})
      col = col + string_len(str_val) + 2
      continue

    # Identifiers and keywords
    if is_alpha(ch):
      let ident = ""
      while i < len(source) and is_alnum(source[i]):
        ident = ident + source[i]
        i = i + 1

      let token_type = get_keyword_type(ident)
      if token_type != "IDENTIFIER":
        tokens.append({"type": token_type, "value": ident, "line": line, "col": col})
      el:
        tokens.append({"type": "IDENTIFIER", "value": ident, "line": line, "col": col})
      col = col + string_len(ident)
      continue

    # Symbols and operators
    let sym = ch
    i = i + 1
    col = col + 1

    # Multi-character operators
    if ch == "=" and ch2 == "=":
      sym = "=="
      i = i + 1
      col = col + 1
    el:
      if ch == "!" and ch2 == "=":
        sym = "!="
        i = i + 1
        col = col + 1
      el:
        if ch == "<" and ch2 == "=":
          sym = "<="
          i = i + 1
          col = col + 1
        el:
          if ch == ">" and ch2 == "=":
            sym = ">="
            i = i + 1
            col = col + 1
          el:
            if ch == "&" and ch2 == "&":
              sym = "&&"
              i = i + 1
              col = col + 1
            el:
              if ch == "|" and ch2 == "|":
                sym = "||"
                i = i + 1
                col = col + 1
              el:
                if ch == "+" and ch2 == "=":
                  sym = "+="
                  i = i + 1
                  col = col + 1
                el:
                  if ch == "-" and ch2 == "=":
                    sym = "-="
                    i = i + 1
                    col = col + 1
                  el:
                    if ch == "*" and ch2 == "=":
                      sym = "*="
                      i = i + 1
                      col = col + 1
                    el:
                      if ch == "/" and ch2 == "=":
                        sym = "/="
                        i = i + 1
                        col = col + 1
                      el:
                        if ch == "-" and ch2 == ">":
                          sym = "->"
                          i = i + 1
                          col = col + 1

    let token = {"type": get_symbol_type(sym), "value": sym, "line": line, "col": col}
    tokens.append(token)

  tokens.append({"type": "EOF", "value": none, "line": line, "col": col})
  ret tokens

fn get_keyword_type(word):
  if word == "let":
    ret "LET"
  if word == "fn":
    ret "FN"
  if word == "if":
    ret "IF"
  if word == "else":
    ret "ELSE"
  if word == "while":
    ret "WHILE"
  if word == "for":
    ret "FOR"
  if word == "in":
    ret "IN"
  if word == "return":
    ret "RETURN"
  if word == "break":
    ret "BREAK"
  if word == "continue":
    ret "CONTINUE"
  if word == "true":
    ret "TRUE"
  if word == "false":
    ret "FALSE"
  if word == "none":
    ret "NONE"
  if word == "and":
    ret "AND"
  if word == "or":
    ret "OR"
  if word == "not":
    ret "NOT"
  ret "IDENTIFIER"

fn get_symbol_type(sym):
  if sym == "(":
    ret "LPAREN"
  if sym == ")":
    ret "RPAREN"
  if sym == "{":
    ret "LBRACE"
  if sym == "}":
    ret "RBRACE"
  if sym == "[":
    ret "LBRACKET"
  if sym == "]":
    ret "RBRACKET"
  if sym == ",":
    ret "COMMA"
  if sym == ".":
    ret "DOT"
  if sym == ":":
    ret "COLON"
  if sym == "=":
    ret "ASSIGN"
  if sym == "+":
    ret "PLUS"
  if sym == "-":
    ret "MINUS"
  if sym == "*":
    ret "STAR"
  if sym == "/":
    ret "SLASH"
  if sym == "%":
    ret "PERCENT"
  if sym == "!":
    ret "BANG"
  if sym == "<":
    ret "LT"
  if sym == ">":
    ret "GT"
  if sym == "==":
    ret "EQ"
  if sym == "!=":
    ret "NEQ"
  if sym == "<=":
    ret "LTE"
  if sym == ">=":
    ret "GTE"
  if sym == "&&":
    ret "AND"
  if sym == "||":
    ret "OR"
  if sym == "+=":
    ret "PLUS_ASSIGN"
  if sym == "-=":
    ret "MINUS_ASSIGN"
  if sym == "*=":
    ret "STAR_ASSIGN"
  if sym == "/=":
    ret "SLASH_ASSIGN"
  if sym == "->":
    ret "ARROW"
  ret "SYMBOL"

# ---- Parser ----

fn parse(tokens):
  let stmts = []
  let pos = 0

  while pos < len(tokens):
    let tok = tokens[pos]
    if tok["type"] == "EOF":
      break

    let stmt = parse_stmt(tokens, pos)
    stmts.append(stmt["node"])
    pos = stmt["pos"]

  ret {"type": "Program", "stmts": stmts}

fn parse_stmt(tokens, pos):
  let tok = tokens[pos]

  if tok["type"] == "LET":
    ret parse_let(tokens, pos)
  if tok["type"] == "FN":
    ret parse_fn(tokens, pos)
  if tok["type"] == "IF":
    ret parse_if(tokens, pos)
  if tok["type"] == "WHILE":
    ret parse_while(tokens, pos)
  if tok["type"] == "FOR":
    ret parse_for(tokens, pos)
  if tok["type"] == "RETURN":
    ret parse_return(tokens, pos)
  if tok["type"] == "BREAK":
    ret {"node": {"type": "Break"}, "pos": pos + 1}
  if tok["type"] == "CONTINUE":
    ret {"node": {"type": "Continue"}, "pos": pos + 1}

  # Expression statement
  let result = parse_expr(tokens, pos)
  ret {"node": {"type": "ExprStmt", "expr": result["node"]}, "pos": result["pos"]}

fn parse_let(tokens, pos):
  pos = pos + 1  # skip 'let'
  let name = tokens[pos]["value"]
  pos = pos + 1  # skip identifier

  if tokens[pos]["type"] == "ASSIGN":
    pos = pos + 1  # skip '='
    let result = parse_expr(tokens, pos)
    ret {"node": {"type": "Let", "name": name, "value": result["node"]}, "pos": result["pos"]}

  ret {"node": {"type": "Let", "name": name, "value": none}, "pos": pos}

fn parse_fn(tokens, pos):
  pos = pos + 1  # skip 'fn'
  let name = tokens[pos]["value"]
  pos = pos + 1  # skip name

  # Parse params
  pos = pos + 1  # skip '('
  let params = []
  while tokens[pos]["type"] != "RPAREN":
    params.append(tokens[pos]["value"])
    pos = pos + 1
    if tokens[pos]["type"] == "COMMA":
      pos = pos + 1
  pos = pos + 1  # skip ')'

  # Parse body
  pos = pos + 1  # skip ':'
  let body = []
  while tokens[pos]["type"] != "RBRACE":
    let result = parse_stmt(tokens, pos)
    body.append(result["node"])
    pos = result["pos"]
  pos = pos + 1  # skip '}'

  ret {"node": {"type": "Fn", "name": name, "params": params, "body": body}, "pos": pos}

fn parse_if(tokens, pos):
  pos = pos + 1  # skip 'if'
  let result = parse_expr(tokens, pos)
  let condition = result["node"]
  pos = result["pos"]

  pos = pos + 1  # skip ':'
  let body = []
  while tokens[pos]["type"] != "RBRACE":
    let stmt = parse_stmt(tokens, pos)
    body.append(stmt["node"])
    pos = stmt["pos"]
  pos = pos + 1  # skip '}'

  let else_body = none
  if pos < len(tokens) and tokens[pos]["type"] == "ELSE":
    pos = pos + 1  # skip 'else'
    if pos < len(tokens) and tokens[pos]["type"] == "IF":
      let else_if = parse_if(tokens, pos)
      else_body = [else_if["node"]]
      pos = else_if["pos"]
    el:
      pos = pos + 1  # skip ':'
      else_body = []
      while tokens[pos]["type"] != "RBRACE":
        let stmt = parse_stmt(tokens, pos)
        else_body.append(stmt["node"])
        pos = stmt["pos"]
      pos = pos + 1  # skip '}'

  ret {"node": {"type": "If", "condition": condition, "body": body, "else_body": else_body}, "pos": pos}

fn parse_while(tokens, pos):
  pos = pos + 1  # skip 'while'
  let result = parse_expr(tokens, pos)
  let condition = result["node"]
  pos = result["pos"]

  pos = pos + 1  # skip ':'
  let body = []
  while tokens[pos]["type"] != "RBRACE":
    let stmt = parse_stmt(tokens, pos)
    body.append(stmt["node"])
    pos = stmt["pos"]
  pos = pos + 1  # skip '}'

  ret {"node": {"type": "While", "condition": condition, "body": body}, "pos": pos}

fn parse_for(tokens, pos):
  pos = pos + 1  # skip 'for'
  let var_name = tokens[pos]["value"]
  pos = pos + 1  # skip variable
  pos = pos + 1  # skip 'in'
  let result = parse_expr(tokens, pos)
  let iterable = result["node"]
  pos = result["pos"]

  pos = pos + 1  # skip ':'
  let body = []
  while tokens[pos]["type"] != "RBRACE":
    let stmt = parse_stmt(tokens, pos)
    body.append(stmt["node"])
    pos = stmt["pos"]
  pos = pos + 1  # skip '}'

  ret {"node": {"type": "For", "var": var_name, "iterable": iterable, "body": body}, "pos": pos}

fn parse_return(tokens, pos):
  pos = pos + 1  # skip 'return'
  let value = none
  if pos < len(tokens) and tokens[pos]["type"] != "RBRACE":
    let result = parse_expr(tokens, pos)
    value = result["node"]
    pos = result["pos"]
  ret {"node": {"type": "Return", "value": value}, "pos": pos}

# ---- Expression Parser (Pratt parser) ----

fn parse_expr(tokens, pos):
  ret parse_comparison(tokens, pos)

fn parse_comparison(tokens, pos):
  let left = parse_addition(tokens, pos)

  while left["pos"] < len(tokens):
    let tok = tokens[left["pos"]]
    if tok["type"] == "EQ" or tok["type"] == "NEQ" or tok["type"] == "LT" or tok["type"] == "GT" or tok["type"] == "LTE" or tok["type"] == "GTE":
      let right = parse_addition(tokens, left["pos"] + 1)
      left = {"node": {"type": "BinOp", "op": tok["value"], "left": left["node"], "right": right["node"]}, "pos": right["pos"]}
    el:
      break

  ret left

fn parse_addition(tokens, pos):
  let left = parse_multiplication(tokens, pos)

  while left["pos"] < len(tokens):
    let tok = tokens[left["pos"]]
    if tok["type"] == "PLUS" or tok["type"] == "MINUS":
      let right = parse_multiplication(tokens, left["pos"] + 1)
      left = {"node": {"type": "BinOp", "op": tok["value"], "left": left["node"], "right": right["node"]}, "pos": right["pos"]}
    el:
      break

  ret left

fn parse_multiplication(tokens, pos):
  let left = parse_unary(tokens, pos)

  while left["pos"] < len(tokens):
    let tok = tokens[left["pos"]]
    if tok["type"] == "STAR" or tok["type"] == "SLASH" or tok["type"] == "PERCENT":
      let right = parse_unary(tokens, left["pos"] + 1)
      left = {"node": {"type": "BinOp", "op": tok["value"], "left": left["node"], "right": right["node"]}, "pos": right["pos"]}
    el:
      break

  ret left

fn parse_unary(tokens, pos):
  let tok = tokens[pos]

  if tok["type"] == "MINUS":
    let result = parse_primary(tokens, pos + 1)
    ret {"node": {"type": "UnaryOp", "op": "-", "operand": result["node"]}, "pos": result["pos"]}
  if tok["type"] == "NOT":
    let result = parse_primary(tokens, pos + 1)
    ret {"node": {"type": "UnaryOp", "op": "not", "operand": result["node"]}, "pos": result["pos"]}

  ret parse_primary(tokens, pos)

fn parse_primary(tokens, pos):
  let tok = tokens[pos]

  # Literals
  if tok["type"] == "NUMBER":
    ret {"node": {"type": "Number", "value": tok["value"]}, "pos": pos + 1}
  if tok["type"] == "FLOAT":
    ret {"node": {"type": "Float", "value": tok["value"]}, "pos": pos + 1}
  if tok["type"] == "STRING":
    ret {"node": {"type": "String", "value": tok["value"]}, "pos": pos + 1}
  if tok["type"] == "TRUE":
    ret {"node": {"type": "Boolean", "value": true}, "pos": pos + 1}
  if tok["type"] == "FALSE":
    ret {"node": {"type": "Boolean", "value": false}, "pos": pos + 1}
  if tok["type"] == "NONE":
    ret {"node": {"type": "None"}, "pos": pos + 1}

  # Identifier or function call
  if tok["type"] == "IDENTIFIER":
    # Check for function call
    if pos + 1 < len(tokens) and tokens[pos + 1]["type"] == "LPAREN":
      ret parse_call(tokens, pos)
    ret {"node": {"type": "Identifier", "name": tok["value"]}, "pos": pos + 1}

  # Parenthesized expression
  if tok["type"] == "LPAREN":
    let result = parse_expr(tokens, pos + 1)
    ret {"node": result["node"], "pos": result["pos"] + 1}

  # List literal
  if tok["type"] == "LBRACKET":
    ret parse_list(tokens, pos)

  # Dict literal
  if tok["type"] == "LBRACE":
    ret parse_dict(tokens, pos)

  ret {"node": {"type": "None"}, "pos": pos + 1}

fn parse_call(tokens, pos):
  let name = tokens[pos]["value"]
  pos = pos + 1  # skip name
  pos = pos + 1  # skip '('

  let args = []
  if tokens[pos]["type"] != "RPAREN":
    let result = parse_expr(tokens, pos)
    args.append(result["node"])
    pos = result["pos"]

    while pos < len(tokens) and tokens[pos]["type"] == "COMMA":
      pos = pos + 1
      result = parse_expr(tokens, pos)
      args.append(result["node"])
      pos = result["pos"]
  pos = pos + 1  # skip ')'

  # Check for method call (dot notation)
  while pos < len(tokens) and tokens[pos]["type"] == "DOT":
    pos = pos + 1  # skip '.'
    let method = tokens[pos]["value"]
    pos = pos + 1  # skip method name

    if pos < len(tokens) and tokens[pos]["type"] == "LPAREN":
      pos = pos + 1  # skip '('
      let method_args = [{"type": "CallResult", "expr": {"type": "Call", "name": name, "args": args}}]

      if tokens[pos]["type"] != "RPAREN":
        let result = parse_expr(tokens, pos)
        method_args.append(result["node"])
        pos = result["pos"]

        while pos < len(tokens) and tokens[pos]["type"] == "COMMA":
          pos = pos + 1
          result = parse_expr(tokens, pos)
          method_args.append(result["node"])
          pos = result["pos"]
      pos = pos + 1  # skip ')'

      name = "method_call"
      args = method_args
    el:
      # Property access
      name = "property_access"
      args = [{"type": "CallResult", "expr": {"type": "Call", "name": name, "args": args}}, {"type": "String", "value": method}]

  ret {"node": {"type": "Call", "name": name, "args": args}, "pos": pos}

fn parse_list(tokens, pos):
  pos = pos + 1  # skip '['
  let elements = []

  if tokens[pos]["type"] != "RBRACKET":
    let result = parse_expr(tokens, pos)
    elements.append(result["node"])
    pos = result["pos"]

    while pos < len(tokens) and tokens[pos]["type"] == "COMMA":
      pos = pos + 1
      result = parse_expr(tokens, pos)
      elements.append(result["node"])
      pos = result["pos"]
  pos = pos + 1  # skip ']'

  ret {"node": {"type": "List", "elements": elements}, "pos": pos}

fn parse_dict(tokens, pos):
  pos = pos + 1  # skip '{'
  let entries = []

  if tokens[pos]["type"] != "RBRACE":
    let key = parse_expr(tokens, pos)
    pos = key["pos"]
    pos = pos + 1  # skip ':'
    let value = parse_expr(tokens, pos)
    entries.append({"key": key["node"], "value": value["node"]})
    pos = value["pos"]

    while pos < len(tokens) and tokens[pos]["type"] == "COMMA":
      pos = pos + 1
      key = parse_expr(tokens, pos)
      pos = key["pos"]
      pos = pos + 1  # skip ':'
      value = parse_expr(tokens, pos)
      entries.append({"key": key["node"], "value": value["node"]})
      pos = value["pos"]
  pos = pos + 1  # skip '}'

  ret {"node": {"type": "Dict", "entries": entries}, "pos": pos}

# ---- Evaluator ----

fn create_global_env():
  let env = {
    "variables": {},
    "parent": none
  }

  # Built-in functions
  env["variables"]["print"] = {"type": "builtin", "fn": builtin_print}
  env["variables"]["len"] = {"type": "builtin", "fn": builtin_len}
  env["variables"]["str"] = {"type": "builtin", "fn": builtin_str}
  env["variables"]["int"] = {"type": "builtin", "fn": builtin_int}
  env["variables"]["float"] = {"type": "builtin", "fn": builtin_float}
  env["variables"]["input"] = {"type": "builtin", "fn": builtin_input}
  env["variables"]["type"] = {"type": "builtin", "fn": builtin_type}
  env["variables"]["append"] = {"type": "builtin", "fn": builtin_append}
  env["variables"]["range"] = {"type": "builtin", "fn": builtin_range}
  env["variables"]["read_file"] = {"type": "builtin", "fn": builtin_read_file}
  env["variables"]["write_file"] = {"type": "builtin", "fn": builtin_write_file}
  env["variables"]["sys_args"] = {"type": "builtin", "fn": builtin_sys_args}
  env["variables"]["sys_exit"] = {"type": "builtin", "fn": builtin_sys_exit}
  env["variables"]["math"] = {"type": "module", "values": {
    "pi": 3.14159265358979,
    "e": 2.71828182845905
  }}

  ret env

fn eval_program(ast, env):
  let result = none
  for stmt in ast["stmts"]:
    result = eval_stmt(stmt, env)
    if type(result) == "return":
      ret result["value"]
    if type(result) == "break" or type(result) == "continue":
      break
  ret result

fn eval_stmt(stmt, env):
  if stmt["type"] == "Let":
    let value = eval_stmt_value(stmt["value"], env)
    env["variables"][stmt["name"]] = value
    ret none

  if stmt["type"] == "Fn":
    env["variables"][stmt["name"]] = {"type": "function", "params": stmt["params"], "body": stmt["body"], "env": env}
    ret none

  if stmt["type"] == "If":
    let condition = eval_stmt_value(stmt["condition"], env)
    if is_truthy(condition):
      let result = none
      for body_stmt in stmt["body"]:
        result = eval_stmt(body_stmt, env)
        if type(result) == "return" or type(result) == "break" or type(result) == "continue":
          ret result
      ret result
    el:
      if stmt["else_body"] != none:
        let result = none
        for body_stmt in stmt["else_body"]:
          result = eval_stmt(body_stmt, env)
          if type(result) == "return" or type(result) == "break" or type(result) == "continue":
            ret result
        ret result
    ret none

  if stmt["type"] == "While":
    while is_truthy(eval_stmt_value(stmt["condition"], env)):
      let result = none
      for body_stmt in stmt["body"]:
        result = eval_stmt(body_stmt, env)
        if type(result) == "return":
          ret result
        if type(result) == "break":
          ret none
        if type(result) == "continue":
          break
    ret none

  if stmt["type"] == "For":
    let iterable = eval_stmt_value(stmt["iterable"], env)
    for item in iterable:
      env["variables"][stmt["var"]] = item
      let result = none
      for body_stmt in stmt["body"]:
        result = eval_stmt(body_stmt, env)
        if type(result) == "return":
          ret result
        if type(result) == "break":
          ret none
        if type(result) == "continue":
          break
    ret none

  if stmt["type"] == "Return":
    let value = none
    if stmt["value"] != none:
      value = eval_stmt_value(stmt["value"], env)
    ret {"type": "return", "value": value}

  if stmt["type"] == "Break":
    ret {"type": "break"}

  if stmt["type"] == "Continue":
    ret {"type": "continue"}

  if stmt["type"] == "ExprStmt":
    ret eval_stmt_value(stmt["expr"], env)

  ret none

fn eval_stmt_value(expr, env):
  if expr["type"] == "Number":
    ret expr["value"]
  if expr["type"] == "Float":
    ret expr["value"]
  if expr["type"] == "String":
    ret expr["value"]
  if expr["type"] == "Boolean":
    ret expr["value"]
  if expr["type"] == "None":
    ret none

  if expr["type"] == "Identifier":
    ret lookup_var(expr["name"], env)

  if expr["type"] == "BinOp":
    let left = eval_stmt_value(expr["left"], env)
    let right = eval_stmt_value(expr["right"], env)
    ret eval_binop(expr["op"], left, right)

  if expr["type"] == "UnaryOp":
    let operand = eval_stmt_value(expr["operand"], env)
    if expr["op"] == "-":
      ret -operand
    if expr["op"] == "not":
      ret not is_truthy(operand)

  if expr["type"] == "Call":
    let callee = lookup_var(expr["name"], env)
    let args = []
    for arg in expr["args"]:
      args.append(eval_stmt_value(arg, env))
    ret call_function(callee, args, env)

  if expr["type"] == "List":
    let elements = []
    for elem in expr["elements"]:
      elements.append(eval_stmt_value(elem, env))
    ret elements

  if expr["type"] == "Dict":
    let entries = {}
    for entry in expr["entries"]:
      let key = eval_stmt_value(entry["key"], env)
      let value = eval_stmt_value(entry["value"], env)
      entries[str(key)] = value
    ret entries

  ret none

fn eval_binop(op, left, right):
  if op == "+":
    ret left + right
  if op == "-":
    ret left - right
  if op == "*":
    ret left * right
  if op == "/":
    ret left / right
  if op == "%":
    ret left % right
  if op == "==":
    ret left == right
  if op == "!=":
    ret left != right
  if op == "<":
    ret left < right
  if op == ">":
    ret left > right
  if op == "<=":
    ret left <= right
  if op == ">=":
    ret left >= right
  if op == "&&":
    ret is_truthy(left) and is_truthy(right)
  if op == "||":
    ret is_truthy(left) or is_truthy(right)
  ret none

fn is_truthy(val):
  if val == none:
    ret false
  if val == false:
    ret false
  if val == 0:
    ret false
  if val == "":
    ret false
  ret true

fn lookup_var(name, env):
  if name in env["variables"]:
    ret env["variables"][name]
  if env["parent"] != none:
    ret lookup_var(name, env["parent"])
  print("Error: undefined variable '" + name + "'")
  ret none

fn call_function(callee, args, env):
  if callee["type"] == "builtin":
    ret call_host_fn(callee["fn"], args)

  if callee["type"] == "function":
    let child_env = {"variables": {}, "parent": callee["env"]}
    let params = callee["params"]
    for i in range(len(params)):
      child_env["variables"][params[i]] = args[i]

    let result = none
    for stmt in callee["body"]:
      result = eval_stmt(stmt, child_env)
      if type(result) == "return":
        ret result["value"]
    ret result

  print("Error: not callable")
  ret none

# ---- Built-in Functions ----

fn builtin_print(args):
  let parts = []
  for arg in args:
    parts.append(str(arg))
  print(parts.join(" "))
  ret none

fn builtin_len(args):
  let obj = args[0]
  if type(obj) == "string":
    let count = 0
    for ch in obj:
      count = count + 1
    ret count
  if type(obj) == "list":
    let count = 0
    for item in obj:
      count = count + 1
    ret count
  ret 0

fn builtin_str(args):
  ret str(args[0])

fn builtin_int(args):
  ret int(args[0])

fn builtin_float(args):
  ret float(args[0])

fn builtin_input(args):
  ret input(args[0])

fn builtin_type(args):
  ret type(args[0])

fn builtin_append(args):
  let list = args[0]
  let item = args[1]
  list.append(item)
  ret none

fn builtin_range(args):
  let end = args[0]
  let result = []
  let i = 0
  while i < end:
    result.append(i)
    i = i + 1
  ret result

fn builtin_read_file(args):
  ret read_file(args[0])

fn builtin_write_file(args):
  write_file(args[0], args[1])
  ret none

fn builtin_sys_args():
  ret sys_args()

fn builtin_sys_exit(args):
  sys_exit(args[0])
  ret none

# ---- Helpers ----

fn is_alpha(ch):
  ret (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or ch == "_"

fn is_alnum(ch):
  ret is_alpha(ch) or (ch >= "0" and ch <= "9")

fn string_len(s):
  let count = 0
  for ch in s:
    count = count + 1
  ret count

# ---- Main Execution ----

let args = sys_args()
if len(args) < 2:
  print("Usage: zpx run zpx_interpreter.zpx <script.zpx>")
  print("  or:  zpx run zpx_interpreter.zpx --repl")
  sys_exit(1)

let script_file = args[1]

if script_file == "--repl":
  run_repl()
el:
  let source = read_file(script_file)
  let result = execute(source, script_file)
  if result != none:
    print(result)
