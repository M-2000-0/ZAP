# Sorting Algorithms in Zpx

# Bubble Sort
fn bubble_sort(arr):
  let n = len(arr)
  let result = []
  for item in arr:
    result.append(item)
  let i = 0
  while i < n:
    let j = 0
    while j < n - i - 1:
      if result[j] > result[j + 1]:
        let temp = result[j]
        result[j] = result[j + 1]
        result[j + 1] = temp
      j = j + 1
    i = i + 1
  ret result

# Selection Sort
fn selection_sort(arr):
  let n = len(arr)
  let result = []
  for item in arr:
    result.append(item)
  let i = 0
  while i < n - 1:
    let min_idx = i
    let j = i + 1
    while j < n:
      if result[j] < result[min_idx]:
        min_idx = j
      j = j + 1
    if min_idx != i:
      let temp = result[i]
      result[i] = result[min_idx]
      result[min_idx] = temp
    i = i + 1
  ret result

# Insertion Sort
fn insertion_sort(arr):
  let n = len(arr)
  let result = []
  for item in arr:
    result.append(item)
  let i = 1
  while i < n:
    let key = result[i]
    let j = i - 1
    while j >= 0 and result[j] > key:
      result[j + 1] = result[j]
      j = j - 1
    result[j + 1] = key
    i = i + 1
  ret result

# Quick Sort
fn quick_sort(arr):
  if len(arr) <= 1:
    ret arr
  let pivot = arr[0]
  let left = []
  let right = []
  let i = 1
  while i < len(arr):
    if arr[i] < pivot:
      left.append(arr[i])
    el:
      right.append(arr[i])
    i = i + 1
  ret quick_sort(left) + [pivot] + quick_sort(right)

# Helper
fn is_sorted(arr):
  let i = 0
  while i < len(arr) - 1:
    if arr[i] > arr[i + 1]:
      ret false
    i = i + 1
  ret true

# Demo
print("=== Sorting Algorithms ===")
print("")

let data = [64, 34, 25, 12, 22, 11, 90, 45]
print("Original: " + str(data))
print("")

# Test each algorithm
let b = bubble_sort(data)
print("Bubble Sort:    " + str(b) + " (sorted: " + str(is_sorted(b)) + ")")

let s = selection_sort(data)
print("Selection Sort: " + str(s) + " (sorted: " + str(is_sorted(s)) + ")")

let ins = insertion_sort(data)
print("Insertion Sort: " + str(ins) + " (sorted: " + str(is_sorted(ins)) + ")")

let q = quick_sort(data)
print("Quick Sort:     " + str(q) + " (sorted: " + str(is_sorted(q)) + ")")

# Performance comparison
print("")
print("=== Performance Test ===")
let test_data = []
let i = 0
while i < 100:
  test_data.append(100 - i)
  i = i + 1

print("Sorting 100 elements...")
print("Bubble Sort: " + str(is_sorted(bubble_sort(test_data))))
print("Quick Sort:  " + str(is_sorted(quick_sort(test_data))))