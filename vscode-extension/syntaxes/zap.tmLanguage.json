{
  "name": "Zap",
  "scopeName": "source.zap",
  "fileTypes": ["zap"],
  "patterns": [
    {
      "name": "comment.line.number-sign.zap",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.zap",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.zap",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single.zap",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.zap",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.float.zap",
      "match": "\\b\\d+\\.\\d+\\b"
    },
    {
      "name": "constant.numeric.integer.zap",
      "match": "\\b\\d+\\b"
    },
    {
      "name": "constant.language.boolean.zap",
      "match": "\\b(true|false)\\b"
    },
    {
      "name": "constant.language.none.zap",
      "match": "\\bnone\\b"
    },
    {
      "name": "keyword.control.zap",
      "match": "\\b(if|else|for|in|while|ret|break|continue|pass)\\b"
    },
    {
      "name": "keyword.control.else.zap",
      "match": "\\bel:\\b"
    },
    {
      "name": "keyword.function.zap",
      "match": "\\bfn\\b"
    },
    {
      "name": "keyword.class.zap",
      "match": "\\bclass\\b"
    },
    {
      "name": "keyword.operator.logical.zap",
      "match": "\\b(and|or|not)\\b"
    },
    {
      "name": "keyword.import.zap",
      "match": "\\b(import|from|as|expose)\\b"
    },
    {
      "name": "keyword.other.zap",
      "match": "\\b(let|mut|match|test|doc|check|expect|type|enum|version|channel|schema|api|service|database|concurrent)\\b"
    },
    {
      "name": "support.function.builtin.zap",
      "match": "\\b(print|len|str|int|float|list|type|range|isinstance|raise|abs|max|min|sum|round|map|filter|random|randint|exp|log|sin|cos|floor|ceil|sqrt|say|show|ask|now|wait|clear|today|get|format|json_parse|json_stringify|json_load|json_save|csv_load|csv_save|http_get|http_post|http_server|web_fetch|download|image_load|image_save|read_file|write_file|element|html|render|html_escape|css|signal|effect|serve|config|watch|run|par_map|par_filter|par_for|db_open|db_query|db_query_one|db_exec|db_transaction|db_migrate|db_tables|db_schema|db_close|wifi_scan|wifi_connect|wifi_status|dense|dense_from_weights|tensor|zeros|ones|reshape|pmap|parallel|retry|context_set|context_get|context_save|context_intents|context_add_convention|context_add_decision|exit)\\b"
    },
    {
      "name": "variable.language.self.zap",
      "match": "\\bself\\b"
    },
    {
      "name": "entity.name.function.zap",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
    },
    {
      "name": "entity.name.class.zap",
      "match": "\\b([A-Z][a-zA-Z0-9_]*)\\s*(?=\\{|:|$)"
    },
    {
      "name": "variable.other.zap",
      "match": "\\b([a-z_][a-zA-Z0-9_]*)\\b"
    },
    {
      "name": "keyword.operator.assignment.zap",
      "match": "(\\=|\\+\\=|\\-\\=|\\*\\=|/\\=|%\\=)"
    },
    {
      "name": "keyword.operator.comparison.zap",
      "match": "(==|!=|<=|>=|<|>)"
    },
    {
      "name": "keyword.operator.arithmetic.zap",
      "match": "(\\+|\\-|\\*|/|%)"
    },
    {
      "name": "punctuation.bracket.zap",
      "match": "[\\(\\)\\[\\]\\{\\}]"
    },
    {
      "name": "punctuation.separator.zap",
      "match": "[,;]"
    },
    {
      "name": "punctuation.section.block.zap",
      "match": ":\\s*$"
    }
  ],
  "repository": {}
}
