{
  "name": "Zap",
  "scopeName": "source.zap",
  "fileTypes": ["zap"],
  "injectionSelector": "L:source.zap",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#classes" },
    { "include": "#types" },
    { "include": "#decorators" },
    { "include": "#interpolation" },
    { "include": "#regex" },
    { "include": "#builtins" },
    { "include": "#variables" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.zap",
          "match": "#.*$"
        },
        {
          "name": "comment.block.documentation.zap",
          "begin": "^\\s*#\\s*doc\\b",
          "end": "^\\S",
          "patterns": [
            { "include": "#markdown" }
          ]
        }
      ]
    },
    "markdown": {
      "patterns": [
        { "name": "markup.heading.zap", "match": "^\\s*#{1,6}\\s+.+$" },
        { "name": "markup.bold.zap", "match": "\\*\\*[^*]++\\*\\*" },
        { "name": "markup.italic.zap", "match": "\\*[^*]++\\*" },
        { "name": "markup.underline.link.zap", "match": "\\[[^\\]]+]\\([^)]+\\)" },
        { "name": "markup.inline.raw.zap", "match": "`[^`]+`" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.zap",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#string-escapes" },
            { "include": "#interpolation" }
          ]
        },
        {
          "name": "string.quoted.single.zap",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "include": "#string-escapes" },
            { "include": "#interpolation" }
          ]
        },
        {
          "name": "string.quoted.triple-double.zap",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            { "include": "#string-escapes" },
            { "include": "#interpolation" }
          ]
        },
        {
          "name": "string.quoted.triple-single.zap",
          "begin": "'''",
          "end": "'''",
          "patterns": [
            { "include": "#string-escapes" },
            { "include": "#interpolation" }
          ]
        }
      ]
    },
    "string-escapes": {
      "patterns": [
        { "name": "constant.character.escape.zap", "match": "\\\\." },
        { "name": "constant.character.escape.unicode.zap", "match": "\\\\u[0-9a-fA-F]{4}" },
        { "name": "constant.character.escape.unicode.zap", "match": "\\\\U[0-9a-fA-F]{8}" }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "name": "meta.interpolation.zap",
          "begin": "\\$\\{",
          "end": "\\}",
          "patterns": [
            { "include": "#expressions" }
          ]
        },
        {
          "name": "variable.other.interpolation.zap",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "regex": {
      "patterns": [
        {
          "name": "string.regexp.zap",
          "begin": "/",
          "end": "/[gimsuy]*",
          "patterns": [
            { "name": "constant.character.escape.regexp.zap", "match": "\\\\." },
            { "name": "constant.character.class.regexp.zap", "match": "\\[[^\\]]+\\]" },
            { "name": "keyword.operator.quantifier.regexp.zap", "match": "[*+?{}]" },
            { "name": "keyword.operator.alternation.regexp.zap", "match": "\\|" },
            { "name": "keyword.operator.group.regexp.zap", "match": "\\([^?]|\\)" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.zap", "match": "\\b0x[0-9a-fA-F]+\\b" },
        { "name": "constant.numeric.binary.zap", "match": "\\b0b[01]+\\b" },
        { "name": "constant.numeric.octal.zap", "match": "\\b0o[0-7]+\\b" },
        { "name": "constant.numeric.float.scientific.zap", "match": "\\b\\d+\\.\\d+[eE][+-]?\\d+\\b" },
        { "name": "constant.numeric.float.zap", "match": "\\b\\d+\\.\\d+\\b" },
        { "name": "constant.numeric.integer.zap", "match": "\\b\\d+\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.flow.zap", "match": "\\b(if|el\\s+if|el|for|in|while|ret|break|continue|pass|match|case)\\b" },
        { "name": "keyword.control.exception.zap", "match": "\\b(try|catch|throw|finally)\\b" },
        { "name": "keyword.function.zap", "match": "\\bfn\\b" },
        { "name": "keyword.class.zap", "match": "\\b(class|trait|impl|interface)\\b" },
        { "name": "keyword.operator.logical.zap", "match": "\\b(and|or|not)\\b" },
        { "name": "keyword.operator.comparison.zap", "match": "\\b(is|isnt|in|not\\s+in)\\b" },
        { "name": "keyword.declaration.zap", "match": "\\b(let|mut|const|var)\\b" },
        { "name": "keyword.import.zap", "match": "\\b(import|from|as|expose|module)\\b" },
        { "name": "keyword.type.zap", "match": "\\b(type|enum|interface|alias)\\b" },
        { "name": "keyword.other.zap", "match": "\\b(test|doc|check|expect|schema|api|service|database|concurrent|channel|version|permission|intent)\\b" },
        { "name": "keyword.async.zap", "match": "\\b(async|await|spawn|yield)\\b" },
        { "name": "constant.language.zap", "match": "\\b(true|false|none)\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.assignment.zap", "match": "(\\=|\\+\\=|\\-\\=|\\*\\=|/\\=|%\\=|\\|\\>)" },
        { "name": "keyword.operator.arithmetic.zap", "match": "(\\*\\*|\\+|\\-|\\*|/|%|//)" },
        { "name": "keyword.operator.comparison.zap", "match": "(==|!=|<=|>=|<|>)" },
        { "name": "keyword.operator.pipe.zap", "match": "\\|>" },
        { "name": "keyword.operator.arrow.zap", "match": "=>" },
        { "name": "keyword.operator.spread.zap", "match": "\\.\\.\\." },
        { "name": "keyword.operator.access.zap", "match": "(\\.|\\?\\.)" },
        { "name": "keyword.operator.range.zap", "match": "\\.\\." },
        { "name": "keyword.operator.type.zap", "match": "::" }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.zap",
          "begin": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "beginCaptures": {
            "1": { "name": "keyword.function.zap" },
            "2": { "name": "entity.name.function.zap" }
          },
          "end": "(?=:\\s*$|\\n)",
          "patterns": [
            {
              "name": "meta.function.parameters.zap",
              "begin": "\\(",
              "end": "\\)",
              "patterns": [
                { "include": "#parameters" }
              ]
            },
            { "include": "#type-annotation" },
            { "include": "#generics" }
          ]
        },
        {
          "name": "meta.lambda.zap",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*=>"
        }
      ]
    },
    "parameters": {
      "patterns": [
        { "include": "#parameter" },
        { "include": "#type-annotation" },
        { "include": "#default-value" }
      ]
    },
    "parameter": {
      "patterns": [
        {
          "name": "variable.parameter.zap",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "keyword.operator.rest.zap",
          "match": "\\.\\.\\.[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "default-value": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.zap",
          "match": "="
        },
        { "include": "#expressions" }
      ]
    },
    "classes": {
      "patterns": [
        {
          "name": "meta.class.zap",
          "begin": "\\b(class|trait|interface)\\s+([A-Z][a-zA-Z0-9_]*)",
          "beginCaptures": {
            "1": { "name": "keyword.class.zap" },
            "2": { "name": "entity.name.class.zap" }
          },
          "end": "(?=:\\s*$|\\n)",
          "patterns": [
            { "include": "#generics" },
            { "include": "#extends" },
            { "include": "#implements" }
          ]
        }
      ]
    },
    "extends": {
      "patterns": [
        {
          "name": "keyword.other.extends.zap",
          "match": "\\b(extends|implements)\\b"
        },
        {
          "name": "entity.other.inherited-class.zap",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "implements": {
      "patterns": [
        {
          "name": "keyword.other.implements.zap",
          "match": "\\bimplements\\b"
        }
      ]
    },
    "generics": {
      "patterns": [
        {
          "name": "meta.generic.zap",
          "begin": "\\[",
          "end": "\\]",
          "patterns": [
            {
              "name": "entity.name.type.generic.zap",
              "match": "[A-Z][a-zA-Z0-9_]*"
            },
            { "include": "#types" }
          ]
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.zap",
          "match": "\\b(int|float|str|bool|none|list|dict|set|tuple|range|any|never)\\b"
        },
        {
          "name": "storage.type.compound.zap",
          "match": "\\b(list|dict|set|tuple|optional|result|promise|stream)\\s*\\["
        },
        {
          "name": "storage.type.user.zap",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "keyword.operator.type.zap",
          "match": "\\|"
        },
        { "include": "#generics" }
      ]
    },
    "type-annotation": {
      "patterns": [
        {
          "name": "meta.type-annotation.zap",
          "begin": ":",
          "end": "(?=[,)=:\\n]|\\s*$)",
          "patterns": [{ "include": "#types" }]
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "meta.decorator.zap",
          "begin": "@",
          "end": "(?=\\s*$|\\n)",
          "patterns": [
            {
              "name": "entity.name.function.decorator.zap",
              "match": "[a-zA-Z_][a-zA-Z0-9_]*"
            },
            {
              "name": "meta.decorator.arguments.zap",
              "begin": "\\(",
              "end": "\\)",
              "patterns": [{ "include": "#expressions" }]
            }
          ]
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.io.zap",
          "match": "\\b(print|say|show|ask|read_file|write_file|append_file|read_line|read_all)\\b"
        },
        {
          "name": "support.function.builtin.string.zap",
          "match": "\\b(upper|lower|strip|split|join|replace|startswith|endswith|contains|find|reverse|trim|format|capitalize|title)\\b"
        },
        {
          "name": "support.function.builtin.collection.zap",
          "match": "\\b(len|map|filter|sort|reversed|zip|enumerate|flatten|chunk|unique|any|all|sum|first|last|take|drop|group_by|partition)\\b"
        },
        {
          "name": "support.function.builtin.math.zap",
          "match": "\\b(abs|max|min|round|floor|ceil|sqrt|pow|exp|log|sin|cos|tan|asin|acos|atan|pi|e|rand|randint|seed)\\b"
        },
        {
          "name": "support.function.builtin.type.zap",
          "match": "\\b(type|str|int|float|bool|list|dict|set|tuple|range|isinstance|getattr|hasattr|setattr)\\b"
        },
        {
          "name": "support.function.builtin.async.zap",
          "match": "\\b(par_map|par_filter|par_for|pmap|parallel|spawn|await|async|yield|channel|send|recv|select)\\b"
        },
        {
          "name": "support.function.builtin.io.zap",
          "match": "\\b(json_parse|json_stringify|json_load|json_save|csv_load|csv_save|http_get|http_post|http_put|http_delete|http_patch|web_fetch|download)\\b"
        },
        {
          "name": "support.function.builtin.db.zap",
          "match": "\\b(db_open|db_query|db_query_one|db_exec|db_transaction|db_migrate|db_tables|db_schema|db_close)\\b"
        },
        {
          "name": "support.function.builtin.ml.zap",
          "match": "\\b(tensor|zeros|ones|reshape|dense|conv2d|batch_norm|dropout|relu|sigmoid|tanh|softmax|leaky_relu|elu|mse_loss|cross_entropy_loss|model|train|predict|save_model|load_model)\\b"
        },
        {
          "name": "support.function.builtin.system.zap",
          "match": "\\b(env_get|env_set|exit|sleep|time|now|today|clear|wait|seed|uuid|random_string|sha256|md5|base64_encode|base64_decode)\\b"
        },
        {
          "name": "support.function.builtin.ui.zap",
          "match": "\\b(element|html|render|html_escape|css|signal|effect|serve|run|watch|config)\\b"
        },
        {
          "name": "support.function.builtin.context.zap",
          "match": "\\b(context_set|context_get|context_save|context_intents|context_add_convention|context_add_decision)\\b"
        },
        {
          "name": "support.function.builtin.advanced.zap",
          "match": "\\b(retry|retry_async|timeout|debounce|throttle|memoize|lazy|once)\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        { "name": "variable.language.self.zap", "match": "\\b(self|this)\\b" },
        { "name": "variable.language.super.zap", "match": "\\bsuper\\b" },
        { "name": "variable.other.zap", "match": "\\b[a-z_][a-zA-Z0-9_]*\\b" }
      ]
    },
    "expressions": {
      "patterns": [
        { "include": "#numbers" },
        { "include": "#strings" },
        { "include": "#variables" },
        { "include": "#operators" },
        { "include": "#function-call" },
        { "include": "#list-dict" },
        { "include": "#interpolation" }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "name": "meta.function-call.zap",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\("
        }
      ]
    },
    "list-dict": {
      "patterns": [
        {
          "name": "meta.list-literal.zap",
          "begin": "\\[",
          "end": "\\]",
          "patterns": [{ "include": "#expressions" }]
        },
        {
          "name": "meta.dict-literal.zap",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "name": "meta.dict-entry.zap",
              "match": "([a-zA-Z_][a-zA-Z0-9_]*|\\\"[^\\\"]*\\\"|'[^']*')\\s*:"
            },
            { "include": "#expressions" }
          ]
        }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.bracket.zap", "match": "[\\(\\)\\[\\]\\{\\}]" },
        { "name": "punctuation.separator.zap", "match": "[,;]" },
        { "name": "punctuation.colon.zap", "match": ":" },
        { "name": "punctuation.dot.zap", "match": "\\." }
      ]
    }
  }
}