{
  "name": "zpx-language",
  "displayName": "Zpx Language",
  "description": "AI-native, full-stack programming language with syntax highlighting, autocomplete, error checking, and debugging",
  "version": "0.2.0",
  "publisher": "zpx-lang",
  "icon": "icon.png",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages", "Snippets", "Linters", "Debuggers"],
  "keywords": [
    "zpx", "ai", "language", "full-stack", "syntax highlighting",
    "autocomplete", "intellisense", "linter", "formatter", "debugger",
    "token-efficient", "zero-boilerplate", "self-hosting"
  ],
  "activationEvents": [
    "onLanguage:zpx",
    "workspaceContains:**/*.zpx",
    "onCommand:zpx.runFile",
    "onCommand:zpx.runProject",
    "onCommand:zpx.check",
    "onCommand:zpx.format"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [{
      "id": "zpx",
      "aliases": ["Zpx", "zpx"],
      "extensions": [".zpx"],
      "configuration": "./language-configuration.json",
      "icon": { "light": "./icons/zpx-light.svg", "dark": "./icons/zpx-dark.svg" }
    }],
    "grammars": [{
      "language": "zpx",
      "scopeName": "source.zpx",
      "path": "./syntaxes/zpx.tmLanguage.json"
    }],
    "snippets": [{
      "language": "zpx",
      "path": "./snippets/zpx.json"
    }],
    "commands": [
      { "command": "zpx.runFile", "title": "Zpx: Run File", "icon": "$(play)" },
      { "command": "zpx.runProject", "title": "Zpx: Run Project", "icon": "$(play-circle)" },
      { "command": "zpx.check", "title": "Zpx: Check Types", "icon": "$(beaker)" },
      { "command": "zpx.format", "title": "Zpx: Format Document", "icon": "$(format)" },
      { "command": "zpx.restartServer", "title": "Zpx: Restart Language Server", "icon": "$(sync)" },
      { "command": "zpx.newProject", "title": "Zpx: New Project", "icon": "$(file-add)" },
      { "command": "zpx.showOutput", "title": "Zpx: Show Output", "icon": "$(output)" }
    ],
    "menus": {
      "editor/title": [
        { "when": "resourceLangId == zpx", "command": "zpx.runFile", "group": "navigation", "title": "Run" },
        { "when": "resourceLangId == zpx", "command": "zpx.check", "group": "navigation", "title": "Check" }
      ],
      "editor/context": [
        { "when": "resourceLangId == zpx", "command": "zpx.runFile", "group": "zpx" },
        { "when": "resourceLangId == zpx", "command": "zpx.check", "group": "zpx" },
        { "when": "resourceLangId == zpx", "command": "zpx.format", "group": "zpx" }
      ],
      "explorer/context": [
        { "when": "resourceExtname == .zpx", "command": "zpx.runFile", "group": "zpx" }
      ],
      "commandPalette": [
        { "command": "zpx.runFile", "when": "resourceLangId == zpx" },
        { "command": "zpx.runProject", "when": "resourceLangId == zpx" },
        { "command": "zpx.check", "when": "resourceLangId == zpx" },
        { "command": "zpx.format", "when": "resourceLangId == zpx" },
        { "command": "zpx.newProject" }
      ]
    },
    "keybindings": [
      { "command": "zpx.runFile", "key": "f5", "when": "editorTextFocus && resourceLangId == zpx" },
      { "command": "zpx.check", "key": "ctrl+shift+c", "when": "editorTextFocus && resourceLangId == zpx" },
      { "command": "zpx.format", "key": "shift+alt+f", "when": "editorTextFocus && resourceLangId == zpx" },
      { "command": "editor.action.formatDocument", "key": "shift+alt+f", "when": "editorTextFocus && resourceLangId == zpx" }
    ],
    "configuration": {
      "type": "object",
      "title": "Zpx",
      "properties": {
        "zpx.executablePath": {
          "type": "string",
          "default": "zpx",
          "description": "Path to Zpx executable"
        },
        "zpx.languageServerPath": {
          "type": "string",
          "default": "",
          "description": "Path to Zpx Language Server (optional)"
        },
        "zpx.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Enable real-time diagnostics"
        },
        "zpx.enableFormatOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Format on save"
        },
        "zpx.enableLanguageServer": {
          "type": "boolean",
          "default": true,
          "description": "Enable language server"
        },
        "zpx.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Language server trace level"
        }
      }
    },
    "debuggers": [{
      "type": "zpx",
      "label": "Zpx Debug",
      "program": "${workspaceFolder}",
      "runtime": "zpx",
      "runtimeArgs": ["run", "--debug", "${file}"],
      "languages": ["zpx"],
      "configurationAttributes": {
        "launch": {
          "properties": {
            "program": { "type": "string", "description": "Entry point file" },
            "args": { "type": "array", "items": { "type": "string" }, "description": "Command line arguments" },
            "stopOnEntry": { "type": "boolean", "default": false },
            "console": { "type": "string", "enum": ["internalConsole", "integratedTerminal", "externalTerminal"], "default": "integratedTerminal" }
          }
        }
      }
    }],
    "views": {
      "zpx": [
        { "id": "zpx.output", "name": "Zpx Output" },
        { "id": "zpx.intents", "name": "Active Intents" }
      ]
    },
    "viewsContainers": {
      "activitybar": [{
        "id": "zpx",
        "title": "Zpx",
        "icon": "icons/zpx-activity.svg"
      }]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish",
    "lint": "eslint src --ext ts",
    "test": "jest"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^18.15.0",
    "typescript": "^5.0.0",
    "vscode-test": "^1.6.0",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^8.35.0",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/M-2000-0/ZPX.git"
  },
  "bugs": { "url": "https://github.com/M-2000-0/ZPX/issues" },
  "homepage": "https://github.com/M-2000-0/ZPX/blob/main/vscode-extension/README.md",
  "license": "MIT"
}